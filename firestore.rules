rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 100;
    }

    // Employees collection
    match /employees/{employeeId} {
      allow read: if true;
      allow write: if true;
    }

    // Attendances collection (stores 1 month+ historical data)
    match /attendances/{attendanceId} {
      allow read: if true;
      allow write: if true;
    }

    // Office geofence locations (managed by admin)
    match /offices/{officeId} {
      allow read: if true;
      allow write: if true;
    }

    // Work shift schedules (master shifts managed by admin, read by all)
    match /shifts/{shiftId} {
      allow read: if true;
      allow write: if true;
    }

    // Company departments & divisions (managed by admin, read by all)
    match /departments/{departmentId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
